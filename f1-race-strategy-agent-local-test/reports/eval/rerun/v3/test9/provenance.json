 "reporting": {
  "path": "configs/eval/reporting.yaml",
  "sha256": "7bf04ee516bd0b271d69759431719e0b60489540b183d98f23e92efb4b01d88a",
  "text": "# Pre-registered reporting choices for the evaluation rerun (src/eval/reporting.py, docs/eval.md\n# \"Pre-registered reporting\"). Committed before the held-out set exists. The tables stage reads\n# this file and copies it verbatim, with its sha256, into provenance.json; the scenarios stage\n# records its sha256 in a report set's sampling, and the tables stage refuses a report set\n# (development false) whose recorded sha256 differs from this file's. Editing this file after a\n# report set is built therefore stops its tables.\n\nquestion: does the agent beat the simple rules?\n\ncomparisons:\n  # agent minus each comparator, in this order\n  lead: [run_to_flag, one_stop_total]\n  secondary:\n    actual_strategy: the teams\n    belief_optimizer: what the language model adds over its tools\n  reference_only: [fixed_one_stop, fixed_two_stop]\n  footnote:\n    greedy_crossover: unavailable on about 80% of scenarios (the plan stops immediately)\n\nstatistic:\n  value: mean paired difference in regret_s, agent minus comparator, on scenarios both scored\n  sign: negative means the agent is better\n  interval: 95% percentile cluster bootstrap\n  primary_cluster: race_driver      # (race_id, driver) clusters\n  beside_cluster: race              # race_id clusters, reported beside (the held-out set has nine races)\n  resamples: 2000\n  seed: 0\n  level: 0.95\n  verdict:                          # from the primary interval\n    ahead: the interval excludes zero on the agent's side (entirely below zero)\n    behind: the interval excludes zero on the other side (entirely above zero)\n    level: otherwise\n\ntail:\n  threshold_s: 20                   # the stated threshold: share of decisions more than 20 s from the reference\n  beside_s: [10, 30]\n  also: [median, worst]\n\nheld_out:\n  # reported three ways, in this order; each race named by season and event\n  groups:\n    - name: fresh five\n      label: the five races never examined before this run, the primary test of the corrected system\n      races:\n        - {season: 2021, event: france}\n        - {season: 2021, event: mexico}\n        - {season: 2022, event: miami}\n        - {season: 2022, event: australia}\n        - {season: 2022, event: belgium}\n    - name: earlier four\n      label: a second look, the four races scored once under the superseded protocol\n      races:\n        - {season: 2019, event: monaco}\n        - {season: 2020, event: sakhir}\n        - {season: 2024, event: austria}\n        - {season: 2025, event: austria}\n    - name: all nine\n      label: every held-out race\n      races: all\n  by_era: true\n  development_beside: dev20, reported beside the held-out results and labelled development\n\nrun_settings:\n  agent_passes: 1\n  model: qwen3-30b-a3b\n  AGENT_TURN_REPEAT: run\n  timing_sample: 24                 # isolated, sequential: the reported decision time\n  jobs: 10\n  configs: the default world and belief configs at the tagged commit\n  per_race: 25\n  seed: 0\n  sampling_rule: as_of\n\nhandling:\n  - invalid and unavailable rows are counted and shown per policy\n  - a comparison uses only the scenarios both policies scored\n  - no scenario, race or row is dropped after the fact\n  - nothing is rerun; a resumed pass skips finished scenarios\n\nfidelity_context: >-\n  The judge orders close finishers correctly 0.753 of the time (ceiling 0.745) and its gap between\n  two cars is off by 13.2 s on average (floor 3.2 s); absolute regrets of 4-10 s sit inside that,\n  so paired differences carry the claims.\n"
 },
