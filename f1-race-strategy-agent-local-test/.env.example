# Model backend: anthropic | huggingface
LLM_BACKEND=huggingface

# ---------------- Local Hugging Face ----------------
# Runs directly in this Python process. On Apple Silicon, HF_DEVICE=auto prefers MPS.
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_DEVICE=auto
HF_MAX_NEW_TOKENS=1024
# Optional; only needed for gated/private Hugging Face models.
HF_TOKEN=

# ---------------- Anthropic ----------------
# Only required when LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
