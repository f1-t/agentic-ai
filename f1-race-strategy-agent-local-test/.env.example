# Model backend: anthropic | huggingface | voyager
LLM_BACKEND=huggingface

# ---------------- Local Hugging Face ----------------
# Runs directly in this Python process. On Apple Silicon, HF_DEVICE=auto prefers MPS.
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_DEVICE=auto
HF_MAX_NEW_TOKENS=1024
# Optional; only needed for gated/private Hugging Face models.
HF_TOKEN=

# ---------------- Anthropic ----------------
# Only required when LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# ---------------- ASU RC Voyager ----------------
# Only required when LLM_BACKEND=voyager. Create a key in the Voyager portal
# (https://voyager.rc.asu.edu, profile > Keys; the portal needs the ASU VPN).
# The API itself is reachable without the VPN.
VOYAGER_API_KEY=
VOYAGER_BASE_URL=https://openai.rc.asu.edu/v1
# Any id from GET /v1/models, e.g. qwen3-30b-a3b
VOYAGER_MODEL=qwen3-30b-a3b
VOYAGER_MAX_TOKENS=1024
